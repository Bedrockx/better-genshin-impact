<ui:FluentWindow x:Class="BetterGenshinImpact.View.Windows.MojangBlackListConfigWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:behavior="clr-namespace:BetterGenshinImpact.View.Behavior"
                 Width="560"
                 Height="680"
                 MinWidth="420"
                 MinHeight="480"
                 Title="莫版拾取黑名单"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Auto"
                 WindowStartupLocation="CenterOwner"
                 FontFamily="{DynamicResource TextThemeFontFamily}"
                 behavior:AutoTranslateInterceptor.EnableAutoTranslate="True"
                 mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="莫版拾取黑名单">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="CheckmarkCircle24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Border Grid.Row="1"
                Margin="20,12,20,12"
                Padding="14"
                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8">
            <TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                       Text="默认所有识别到的物品都会拾取，勾选后加入黑名单、不再拾取。"
                       TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2" Margin="20,0,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0"
                        Margin="0,0,12,0"
                        PlaceholderText="搜索交互名"
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Grid.Column="1"
                      Width="96"
                      Margin="0,0,8,0"
                      ItemsSource="{Binding StatusFilters}"
                      SelectedItem="{Binding StatusFilter, Mode=TwoWay}" />
            <ComboBox Grid.Column="2"
                      Width="96"
                      Margin="0,0,8,0"
                      ItemsSource="{Binding ColorFilters}"
                      SelectedItem="{Binding ColorFilter, Mode=TwoWay}" />
            <ui:Button Grid.Column="3"
                       Margin="0,0,8,0"
                       Command="{Binding SelectAllCommand}"
                       Content="勾选所有" />
            <ui:Button Grid.Column="4"
                       Command="{Binding ClearAllCommand}"
                       Content="取消勾选所有" />
        </Grid>

        <ListBox Grid.Row="3"
                 Margin="20,0,20,0"
                 ItemsSource="{Binding ItemsView}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,8,0,4"
                                       FontWeight="SemiBold"
                                       Text="{Binding Name}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Name}"
                              IsChecked="{Binding IsBlackListed, Mode=TwoWay}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="4" Margin="20,16,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                       Text="保存后立即刷新莫版拾取黑名单。" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button MinWidth="88"
                           Margin="0,0,10,0"
                           Command="{Binding CancelCommand}"
                           Content="取消"
                           IsCancel="True" />
                <ui:Button MinWidth="88"
                           Appearance="Primary"
                           Command="{Binding SaveCommand}"
                           Content="保存"
                           IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
